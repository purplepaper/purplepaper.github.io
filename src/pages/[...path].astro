---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPosts, postPath, formatDate, readingMinutes, type Post } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { path: postPath(post) }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const minutes = readingMinutes(post.body);
---
<Base title={post.data.title} description={post.data.summary} type="article">
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {' · '}{minutes} min read
        {post.data.draft && <span class="draft">Draft</span>}
      </p>
    </header>
    <div class="post-content">
      <Content />
    </div>
  </article>
  <aside class="author">
    <img src="/images/dr-muhammed-saho.jpg" alt="" width="56" height="56" />
    <p>
      <strong>Dr. Muhammed Saho</strong> is a manufacturing technology consultant in North America.{' '}
      <a href="https://sahoism.com">More about me</a>.
    </p>
  </aside>
</Base>
